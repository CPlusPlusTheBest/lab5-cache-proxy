  },
  "item": [
    {
      "name": "1. GET 200 — немає в кеші",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код стану 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type: image/jpeg\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\"));",
              "pm.test(\"X-Cache: MISS\", () => pm.expect(pm.response.headers.get(\"X-Cache\")).to.eql(\"MISS\"));",
              "console.log(`${pm.info.requestName}: ${pm.response.responseTime} мс`);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/200",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "200"
          ]
        },
        "description": "Перший запит: картинку отримано з http.cat"
      },
      "response": []
    },
    {
